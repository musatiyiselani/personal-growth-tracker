# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env to Git (it is listed in .gitignore).

# 1. Secret used to sign login tokens. Generate one with:
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_this_with_a_long_random_secret_key

# 2. Your Neon PostgreSQL connection string (see DEPLOYMENT.md, step 1).
#    Use the pooled string (hostname contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# 3. Websites allowed to call the API, separated by commas. The local frontend is included by default.
#    For the deployed site, add your GitHub Pages address, e.g. https://your-username.github.io
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
